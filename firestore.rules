rules_version = '2';

// Logos Novus
//
// commons/{store~id}   the shared library: anyone reads; signed-in accounts write.
//                      Every write carries the next revision number (rev) and the
//                      writer's uid, and must create history/{store~id@rev} in the
//                      same batch with exactly the written content. So every change
//                      is traced to its account and can be undone from history.
// history/{key@rev}    one entry per revision; never changed; only the admin may
//                      delete entries (e.g. to remove content that must go).
// banned/{uid}         accounts that may no longer write (set by the admin).
// accounts/{uid}       name and e-mail of each writer (read by the admin and the account).
// users/{uid}/...      private data of one account (reading positions, preferences,
//                      private texts, API keys if the account chose to sync them).

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'gerksterr@gmail.com' && request.auth.token.email_verified == true;
    }
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }
    function commons(key) {
      return /databases/$(database)/documents/commons/$(key);
    }
    function history(id) {
      return /databases/$(database)/documents/history/$(id);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /commons/{key} {
      allow read: if true;
      allow create, update: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['st', 'id', 'u', 's', 'rev', 'by', 'del', 'j'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.st in ['langs', 'texts', 'prompts', 'providers', 'models', 'translations', 'calques', 'lemmas']
        && key == request.resource.data.st + '~' + request.resource.data.id
        && request.resource.data.s == request.time
        && request.resource.data.u is int
        && request.resource.data.u <= request.time.toMillis() + 600000
        && request.resource.data.rev == (resource == null ? 1 : resource.data.rev + 1)
        && (request.resource.data.get('del', false) == true || (request.resource.data.j is string && request.resource.data.j.size() < 900000))
        && existsAfter(history(key + '@' + string(request.resource.data.rev)));
      allow delete: if false;
    }

    match /history/{hid} {
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['key', 'st', 'id', 'rev', 'by', 'name', 'at', 'u', 'del', 'j', 'revert'])
        && request.resource.data.by == request.auth.uid
        && hid == request.resource.data.key + '@' + string(request.resource.data.rev)
        && request.resource.data.at == request.time
        && request.resource.data.key == request.resource.data.st + '~' + request.resource.data.id
        && getAfter(commons(request.resource.data.key)).data.rev == request.resource.data.rev
        && getAfter(commons(request.resource.data.key)).data.by == request.auth.uid
        && getAfter(commons(request.resource.data.key)).data.u == request.resource.data.u
        && getAfter(commons(request.resource.data.key)).data.get('j', null) == request.resource.data.get('j', null)
        && getAfter(commons(request.resource.data.key)).data.get('del', false) == request.resource.data.get('del', false);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /banned/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /accounts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'first', 'last'])
        && request.resource.data.get('email', '') == request.auth.token.get('email', '');
    }
  }
}
